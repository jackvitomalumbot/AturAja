# ==============================================
# Smart Expense Tracker - Environment Variables
# ==============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# ---- Supabase ----
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ---- Gemini AI (used by Netlify Functions - do NOT prefix with VITE_) ----
GEMINI_API_KEY=your-gemini-api-key-here

# ---- API Base URL (for Android APK) ----
# Kosongkan untuk dev (Netlify dev proxy otomatis handle ini).
# Isi URL deploy Netlify kamu untuk production APK Android.
# Contoh: VITE_API_BASE_URL=https://your-site.netlify.app
VITE_API_BASE_URL=https://your-site.netlify.app
